{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "note_draft",
  "type": "object",
  "required": ["title", "lead", "paid_sections", "cautions", "summary_table", "closing", "hashtags", "images"],
  "properties": {
    "title": {"type": "string", "maxLength": 60},
    "lead": {"type": "array", "items": {"type": "string"}, "minItems": 1, "maxItems": 3},
    "shallowest": {"type": "string"},
    "free_sections": {"type": "array", "items": {"$ref": "#/$defs/section"}},
    "paid_sections": {"type": "array", "items": {"$ref": "#/$defs/section"}},
    "cautions": {"type": "array", "items": {"type": "string"}},
    "summary_table": {"type": "object", "required": ["columns", "rows"],
                      "properties": {"columns": {"type": "array", "items": {"type": "string"}},
                                     "rows": {"type": "array", "items": {"type": "array", "items": {"type": "string"}}}}},
    "closing": {"type": "string"},
    "hashtags": {"type": "array", "items": {"type": "string"}, "maxItems": 8},
    "images": {"type": "array", "maxItems": 3, "items": {"type": "object", "required": ["slot", "emotion", "text"],
               "properties": {"slot": {"type": "string"}, "emotion": {"enum": ["happy", "surprised", "neutral", "relaxed", "angry", "sad"]},
                              "text": {"type": "string", "maxLength": 14}, "subtext": {"type": "string", "maxLength": 24}}}}
  },
  "$defs": {
    "section": {"type": "object", "required": ["heading", "body"],
                "properties": {"heading": {"type": "string"}, "hiyori": {"type": "string", "maxLength": 40},
                               "hiyori_emotion": {"enum": ["happy", "surprised", "neutral", "relaxed", "angry", "sad"]},
                               "body": {"type": "string"}, "sources": {"type": "array", "items": {"type": "string"}}}}
  }
}
